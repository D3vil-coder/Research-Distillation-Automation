{
    "name": "Fetch Research Papers",
    "nodes": [
        {
            "parameters": {
                "path": "papers",
                "responseMode": "responseNode",
                "options": {}
            },
            "id": "1",
            "name": "Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                460,
                300
            ],
            "webhookId": "papers"
        },
        {
            "parameters": {
                "url": "http://export.arxiv.org/api/query?search_query=cat:cs.RO&sortBy=lastUpdatedDate&sortOrder=descending&max_results=8"
            },
            "id": "2",
            "name": "RSS Feed Read",
            "type": "n8n-nodes-base.rssFeedRead",
            "typeVersion": 1,
            "position": [
                680,
                300
            ]
        },
        {
            "parameters": {
                "functionCode": "return items.map(item => {\n  const json = item.json;\n  return {\n    json: {\n      title: json.title || 'Untitled Paper',\n      link: json.link || '#',\n      summary: (json.contentSnippet || json.content || 'No summary available').replace(/<[^>]*>?/gm, '').substring(0, 300) + '...',\n      date: json.isoDate ? new Date(json.isoDate).toISOString().split('T')[0] : new Date().toISOString().split('T')[0]\n    }\n  }\n});"
            },
            "id": "3",
            "name": "Format Data",
            "type": "n8n-nodes-base.function",
            "typeVersion": 1,
            "position": [
                900,
                300
            ]
        },
        {
            "parameters": {
                "respondWith": "allIncomingItems",
                "options": {}
            },
            "id": "4",
            "name": "Respond to Webhook",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                1120,
                300
            ]
        }
    ],
    "connections": {
        "Webhook": {
            "main": [
                [
                    {
                        "node": "RSS Feed Read",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "RSS Feed Read": {
            "main": [
                [
                    {
                        "node": "Format Data",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Format Data": {
            "main": [
                [
                    {
                        "node": "Respond to Webhook",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}